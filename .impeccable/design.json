  "narrative": {
    "northStar": "Sotto's Quiet Editorial Instrument",
    "overview": "Sotto carries its desktop monochrome Manrope identity into a native Android tool. Clear sentences, generous page margins and a restrained type hierarchy make speaking feel direct and deliberate. Capsule actions and the dark recorder supply the recognizable silhouette.\n\nThe implementation is Java Views with Material 3 controls and an InputMethodService keyboard. Native navigation, system Back, scalable text and window insets are part of the design language. Layouts reflow and scroll in portrait, landscape and larger text; an editorial opening is never a reason to hide an action.",
    "keyCharacteristics": [
      "Monochrome semantic roles with a persistent dark recorder.",
      "Manrope lettering with weight-led editorial hierarchy.",
      "Capsule controls, flat outlined containers and soft rectangular keycaps.",
      "Native Android navigation and explicit recording state."
    ],
    "rules": [
      {
        "name": "The Semantic Inversion Rule",
        "body": "Resolve ordinary surfaces and controls through Android light/dark resources. Keep the recorder's charcoal, light text and fixed ink action contrast stable.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use Manrope across Sotto's own controls and editorial copy; retain platform fallback for multilingual text instead of forcing unsupported glyphs.",
        "section": "typography"
      },
      {
        "name": "The Native Reach Rule",
        "body": "Preserve window insets, scalable text and native navigation. Primary app controls and key rows keep their observed touch dimensions; do not shrink them to force a fixed first viewport.",
        "section": "layout"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal fill and quiet outlines for ordinary grouping; do not add decorative shadows to the app's cards or navigation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the monochrome Manrope identity through native Android components.",
      "**Do** resolve theme-sensitive controls through semantic resource colors and preserve the recorder's stable contrast.",
      "**Do** let mode chips wrap and content scroll at larger text sizes and constrained heights.",
      "**Do** retain native focus, ripple, disabled states, content descriptions and system insets.",
      "**Do** distinguish ordinary typing, recording, processing and insertion with explicit visible state."
    ],
    "donts": [
      "**Don't** use the error color as an everyday brand accent.",
      "**Don't** add decorative card shadows or replace stroke icons with text glyphs.",
      "**Don't** copy the capsule silhouette onto individual QWERTY letter keys.",
